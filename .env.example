# Copy these values into your shell environment before running.
# Do not commit real credentials or an actual .env file.

SMTP_USERNAME=your.gmail.address@gmail.com
SMTP_APP_PASSWORD=your_16_character_google_app_password
SENDER_NAME=Faisal Ali

# Absolute path to your resume PDF
RESUME_PATH=/absolute/path/to/your/resume.pdf

# true = preview only (recommended for first run); false = send real emails
DRY_RUN=true

# Optional; defaults to /absolute/path/to/project/outreach-log.csv
OUTREACH_LOG_PATH=outreach-log.csv
